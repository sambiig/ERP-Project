<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <!-- ========== MENU PRINCIPAL ========== -->
    <menuitem id="menu_gestion" name="Gestion" sequence="10"/>
    <menuitem id="menu_vente" name="Vente de vélos et accessoires" parent="menu_gestion" sequence="20"/>
    <menuitem id="menu_location" name="Location de vélos" parent="menu_gestion" sequence="30"/>
    <menuitem id="menu_gestion_location" name="Gestion des locations et clients" parent="menu_gestion" sequence="40"/>
    <menuitem id="menu_reporting" name="Reporting" parent="menu_gestion" sequence="50"/>

    <!-- ========================================================= -->
    <!--        VUES PRODUITS (PRODUCT.TEMPLATE)                   -->
    <!-- ========================================================= -->

    <!-- Liste des produits - version améliorée -->
    <record id="view_bike_shop_product_tree" model="ir.ui.view">
      <field name="name">bike.shop.product.tree</field>
      <field name="model">product.template</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="product_type"/>
          <field name="brand"/>
          <field name="model_name"/>
          <field name="size"/>
          <field name="color"/>
          <field name="list_price" string="Prix de vente"/>
          <field name="rental_price_day" string="Location / jour"/>
          <field name="virtual_available" string="Qté dispo"/>
          <field name="stock_status" decoration-success="stock_status == 'in_stock'" 
                                     decoration-warning="stock_status == 'low_stock'" 
                                     decoration-danger="stock_status == 'out_of_stock'"/>
          <field name="active_rental_count" string="Loc. actives"/>
          <field name="total_rental_revenue" string="Revenus loc." sum="Total"/>
        </list>
      </field>
    </record>

    <!-- Formulaire produit Bike Shop -->
    <record id="view_bike_shop_product_form" model="ir.ui.view">
      <field name="name">bike.shop.product.form</field>
      <field name="model">product.template</field>
      <field name="inherit_id" ref="product.product_template_form_view"/>
      <field name="arch" type="xml">
        <xpath expr="//sheet/notebook" position="inside">
          <page string="Bike Shop">
            <group string="Informations produit">
              <field name="is_bike_shop_item"/>
              <field name="product_type"/>
              <field name="brand"/>
              <field name="model_name"/>
              <field name="size"/>
              <field name="color"/>
            </group>
            <group string="Tarifs location" invisible="product_type != 'bike'">
              <field name="rental_price_hour" string="Prix loc. / heure"/>
              <field name="rental_price_day" string="Prix loc. / jour"/>
              <field name="rental_price_week" string="Prix loc. / semaine"/>
            </group>
            <group string="Statistiques de location" invisible="product_type != 'bike'">
              <field name="active_rental_count"/>
              <field name="total_rental_revenue"/>
            </group>
            <group string="Historique des locations" invisible="product_type != 'bike'">
              <field name="rental_ids" nolabel="1">
                <list>
                  <field name="name"/>
                  <field name="customer_id"/>
                  <field name="start_date"/>
                  <field name="end_date"/>
                  <field name="total_price"/>
                  <field name="state"/>
                </list>
              </field>
            </group>
          </page>
        </xpath>
      </field>
    </record>

    <!-- Vue Kanban pour les produits -->
    <record id="view_bike_shop_product_kanban" model="ir.ui.view">
      <field name="name">bike.shop.product.kanban</field>
      <field name="model">product.template</field>
      <field name="arch" type="xml">
        <kanban>
          <field name="id"/>
          <field name="name"/>
          <field name="product_type"/>
          <field name="brand"/>
          <field name="list_price"/>
          <field name="rental_price_day"/>
          <field name="stock_status"/>
          <field name="qty_available"/>
          <templates>
            <t t-name="kanban-box">
              <div class="oe_kanban_global_click">
                <div class="o_kanban_image">
                  <img t-att-src="kanban_image('product.template', 'image_128', record.id.raw_value)" alt="Product"/>
                </div>
                <div class="oe_kanban_details">
                  <strong><field name="name"/></strong>
                  <ul>
                    <li t-if="record.brand.raw_value"><field name="brand"/></li>
                    <li>Type: <field name="product_type"/></li>
                    <li>Prix: <field name="list_price"/> €</li>
                    <li t-if="record.rental_price_day.raw_value">Location: <field name="rental_price_day"/> €/jour</li>
                    <li>Stock: <field name="qty_available"/></li>
                  </ul>
                </div>
              </div>
            </t>
          </templates>
        </kanban>
      </field>
    </record>

    <!-- Action pour afficher les produits -->
    <record id="action_bike_shop_product" model="ir.actions.act_window">
      <field name="name">Vélos et Accessoires</field>
      <field name="res_model">product.template</field>
      <field name="view_mode">kanban,list,form</field>
      <field name="domain">[('is_bike_shop_item','=',True)]</field>
      <field name="context">{'default_is_bike_shop_item': True}</field>
    </record>

    <menuitem id="menu_vente_products"
              name="Produits"
              parent="menu_vente"
              action="action_bike_shop_product"
              sequence="10"/>

    <!-- ========================================================= -->
    <!--                 VUES LOCATION (BIKE.SHOP.RENTAL)          -->
    <!-- ========================================================= -->

    <!-- Liste des locations -->
    <record id="view_bike_shop_rental_tree" model="ir.ui.view">
      <field name="name">bike.shop.rental.tree</field>
      <field name="model">bike.shop.rental</field>
      <field name="arch" type="xml">
        <list decoration-info="state == 'draft'" 
              decoration-success="state == 'confirmed'" 
              decoration-warning="state == 'in_progress'"
              decoration-muted="state in ['returned', 'cancelled']">
          <field name="name"/>
          <field name="bike_id"/>
          <field name="customer_id"/>
          <field name="start_date"/>
          <field name="end_date"/>
          <field name="rental_type"/>
          <field name="rental_duration_display"/>
          <field name="total_price" sum="Total"/>
          <field name="state"/>
        </list>
      </field>
    </record>

    <!-- Formulaire de location -->
    <record id="view_bike_shop_rental_form" model="ir.ui.view">
      <field name="name">bike.shop.rental.form</field>
      <field name="model">bike.shop.rental</field>
      <field name="arch" type="xml">
        <form string="Location de vélo">
          <header>
            <button name="action_confirm" type="object" string="Confirmer" 
                    invisible="state != 'draft'" class="oe_highlight"/>
            <button name="action_start" type="object" string="Démarrer" 
                    invisible="state != 'confirmed'" class="oe_highlight"/>
            <button name="action_return" type="object" string="Retour" 
                    invisible="state != 'in_progress'" class="oe_highlight"/>
            <button name="action_invoice" type="object" string="Facturer" 
                    invisible="state not in ['in_progress', 'returned'] or invoice_id" 
                    class="oe_highlight"/>
            <button name="action_view_invoice" type="object" string="Voir la facture" 
                    invisible="not invoice_id"/>
            <button name="action_cancel" type="object" string="Annuler" 
                    invisible="state in ['in_progress', 'returned', 'cancelled']"/>
            <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,in_progress,returned"/>
          </header>

          <sheet>
            <div class="oe_button_box" name="button_box">
              <button name="action_view_invoice" type="object" class="oe_stat_button" icon="fa-pencil-square-o"
                      invisible="not invoice_id">
                <field name="invoice_state" widget="label_selection" options="{'classes': {'draft': 'default', 'posted': 'success'}}"/>
              </button>
            </div>

            <div class="oe_title">
              <h1>
                <field name="name" readonly="1"/>
              </h1>
            </div>

            <group>
              <group string="Informations location">
                <field name="bike_id" options="{'no_create': True}"/>
                <field name="customer_id" options="{'no_create': True}"/>
                <field name="rental_type"/>
              </group>
              <group string="Période et tarif">
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="rental_duration_display" readonly="1"/>
                <field name="unit_price"/>
                <field name="late_fee" invisible="late_fee == 0"/>
                <field name="total_price" readonly="1" class="oe_subtotal_footer_separator"/>
                <field name="is_late" invisible="1"/>
              </group>
            </group>

            <group string="Notes">
              <field name="notes" nolabel="1" placeholder="Notes additionnelles..."/>
            </group>
          </sheet>

          <!-- Chatter pour le suivi -->
         
        </form>
      </field>
    </record>

    <!-- Vue Kanban pour les locations -->
    <record id="view_bike_shop_rental_kanban" model="ir.ui.view">
      <field name="name">bike.shop.rental.kanban</field>
      <field name="model">bike.shop.rental</field>
      <field name="arch" type="xml">
        <kanban default_group_by="state">
          <field name="name"/>
          <field name="bike_id"/>
          <field name="customer_id"/>
          <field name="start_date"/>
          <field name="end_date"/>
          <field name="total_price"/>
          <field name="state"/>
          <field name="is_late"/>
          <templates>
            <t t-name="kanban-box">
              <div class="oe_kanban_global_click">
                <div class="oe_kanban_content">
                  <div class="o_kanban_record_top">
                    <div class="o_kanban_record_headings">
                      <strong class="o_kanban_record_title"><field name="name"/></strong>
                    </div>
                    <span class="badge badge-pill" t-if="record.is_late.raw_value">⚠️ Retard</span>
                  </div>
                  <div class="o_kanban_record_body">
                    <field name="bike_id"/>
                    <br/>
                    Client: <field name="customer_id"/>
                  </div>
                  <div class="o_kanban_record_bottom">
                    <div class="oe_kanban_bottom_left">
                      <strong><field name="total_price"/> €</strong>
                    </div>
                  </div>
                </div>
              </div>
            </t>
          </templates>
        </kanban>
      </field>
    </record>

    <!-- Vue de recherche simplifiée -->
    <record id="view_bike_shop_rental_search" model="ir.ui.view">
      <field name="name">bike.shop.rental.search</field>
      <field name="model">bike.shop.rental</field>
      <field name="arch" type="xml">
        <search>
          <field name="name"/>
          <field name="bike_id"/>
          <field name="customer_id"/>
        </search>
      </field>
    </record>

    <!-- Vue Calendrier -->
    <record id="view_bike_shop_rental_calendar" model="ir.ui.view">
      <field name="name">bike.shop.rental.calendar</field>
      <field name="model">bike.shop.rental</field>
      <field name="arch" type="xml">
        <calendar string="Calendrier des locations" 
                  date_start="start_date" 
                  date_stop="end_date"
                  color="bike_id"
                  mode="month">
          <field name="bike_id"/>
          <field name="customer_id"/>
          <field name="total_price"/>
        </calendar>
      </field>
    </record>

    <!-- Vue Graphique -->
    <record id="view_bike_shop_rental_graph" model="ir.ui.view">
      <field name="name">bike.shop.rental.graph</field>
      <field name="model">bike.shop.rental</field>
      <field name="arch" type="xml">
        <graph string="Statistiques des locations" type="bar">
          <field name="start_date" interval="month"/>
          <field name="total_price" type="measure"/>
        </graph>
      </field>
    </record>

    <!-- Vue Pivot -->
    <record id="view_bike_shop_rental_pivot" model="ir.ui.view">
      <field name="name">bike.shop.rental.pivot</field>
      <field name="model">bike.shop.rental</field>
      <field name="arch" type="xml">
        <pivot string="Analyse des locations">
          <field name="bike_id" type="row"/>
          <field name="start_date" interval="month" type="col"/>
          <field name="total_price" type="measure"/>
        </pivot>
      </field>
    </record>

    <!-- Action liste/form pour les locations -->
    <record id="action_bike_shop_rental" model="ir.actions.act_window">
      <field name="name">Locations</field>
      <field name="res_model">bike.shop.rental</field>
      <field name="view_mode">kanban,list,form,calendar,graph,pivot</field>
    </record>

    <menuitem id="menu_location_management"
              name="Gestion des locations"
              parent="menu_location"
              action="action_bike_shop_rental"
              sequence="10"/>

    <!-- ========================================================= -->
    <!--                     CLIENTS (RES.PARTNER)                 -->
    <!-- ========================================================= -->

    <record id="action_bike_shop_customer" model="ir.actions.act_window">
      <field name="name">Clients</field>
      <field name="res_model">res.partner</field>
      <field name="view_mode">list,form</field>
      <field name="domain">[('customer_rank', '&gt;', 0)]</field>
      <field name="context">{'default_customer_rank': 1}</field>
    </record>

    <menuitem id="menu_gestion_clients"
              name="Liste des clients"
              parent="menu_gestion_location"
              action="action_bike_shop_customer"
              sequence="10"/>

    <menuitem id="menu_gestion_locations"
              name="Toutes les locations"
              parent="menu_gestion_location"
              action="action_bike_shop_rental"
              sequence="20"/>

    <!-- ========================================================= -->
    <!--                     DASHBOARD / REPORTING                 -->
    <!-- ========================================================= -->

    <!-- Dashboard locations -->
    <record id="action_bike_shop_rental_dashboard" model="ir.actions.act_window">
      <field name="name">Dashboard Locations</field>
      <field name="res_model">bike.shop.rental</field>
      <field name="view_mode">graph,pivot,kanban,list</field>
    </record>

    <menuitem id="menu_reporting_dashboard"
              name="Dashboard Locations"
              parent="menu_reporting"
              action="action_bike_shop_rental_dashboard"
              sequence="10"/>

    <!-- Vélos les plus loués -->
    <record id="action_bike_shop_top_bikes" model="ir.actions.act_window">
      <field name="name">Vélos les plus loués</field>
      <field name="res_model">product.template</field>
      <field name="view_mode">list,form</field>
      <field name="domain">[('is_bike_shop_item','=',True), ('product_type','=','bike')]</field>
    </record>

    <menuitem id="menu_reporting_top_bikes"
              name="Vélos les plus loués"
              parent="menu_reporting"
              action="action_bike_shop_top_bikes"
              sequence="20"/>

  </data>
</odoo>